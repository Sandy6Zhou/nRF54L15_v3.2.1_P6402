#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/ {
	chosen {
		/* LCD 显示屏（ST7735） */
		zephyr,display = &lcd_st7735r;
	};

	/* 定义别名，方便代码调用 */
	aliases {
		/* 删除板级alias别名 */
		/delete-property/ led0;
		/delete-property/ led1;
		/delete-property/ led2;
		/delete-property/ led3;
		/delete-property/ pwm-led0;
		/delete-property/ sw0;
		/delete-property/ sw1;
		/delete-property/ sw2;
		/delete-property/ sw3;
		/delete-property/ mcuboot-button0;
		/delete-property/ mcuboot-led0;
		lte-uart = &uart30;
		lte-pwr-ctrl = &lte_pwr_en;
		lte-wake-ctrl = &lte_wake_pin;
		gsensor-i2c = &i2c21;
		battery-gauge-i2c = &i2c21;
		gsensor-pwr-ctrl = &gsensor_pwr_en;
		buzzer-pwm = &buzzer_pwm_0;
		fun-key = &fun_key_pin;
		charge-pwr-ctrl = &charge_pwr_en;
		gsensor-int = &gsen_int;
		battery-gauge-int = &battery_gauge_int;
		charge-detect = &charge_det;
		wifi-uart = &uart20;
		wifi-pwr-ctrl = &wifi_pwr_en;
		wifi-wake-ctrl = &wifi_wake_pin;
		sos-key = &sos_key_pin;
		baro-pwr-ctrl = &baro_pwr_en;
		baro-i2c = &i2c22;
		lcd-backlight = &lcd_bl_0;
		lcd-pwr-ctrl = &lcd_pwr_en;
	};
	/* 删除板级节点 */
	/delete-node/ leds;
	/delete-node/ buttons;
	/delete-node/ pwmleds;

	/* 定义按键 - 使用 gpio-keys 兼容类型 */
	button_fun: button_fun {
		compatible = "gpio-keys";
		fun_key_pin: fun_key_pin {
			gpios = <&gpio1 9 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "FUN KEY";
		};
	};

	/* SOS 按键：P1.14，下拉输入，高电平有效 */
	button_sos: button_sos {
		compatible = "gpio-keys";
		sos_key_pin: sos_key_pin {
			gpios = <&gpio1 14 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "SOS KEY";
		};
	};

	/* 定义蜂鸣器 PWM 节点 */
	buzzer_node {
		compatible = "pwm-leds";
		buzzer_pwm_0: buzzer_pwm_0 {
			/* 蜂鸣器设置2.7KHz */
			pwms = <&pwm20 0 PWM_HZ(2700) PWM_POLARITY_NORMAL>;
		};
	};

	/* 六轴传感器电源控制引脚配置：P2.10，低电平有效 */
	gsensor_pwr_en: gsensor-pwr-en {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	/* 4G 电源控制引脚配置：P2.06，高电平有效 */
	lte_pwr_en: lte-pwr-en {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 6 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	/* WIFI 电源控制引脚配置：P2.08，高电平有效 */
	wifi_pwr_en: wifi-pwr-en {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 8 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	/* LTE 唤醒引脚配置：P0.04，外部上拉，4G拉低唤醒Nordic */
	lte_wake_pin: lte-wake-pin {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	/* WIFI 唤醒引脚配置：P0.02，外部上拉，WIFI拉低唤醒Nordic */
	wifi_wake_pin: wifi-wake-pin {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	/* P2.7: 充电使能，低电平使能 */
	charge_pwr_en: charge-pwr-en {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 7 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	/* gsensor中断，默认下拉 */
	gsen_int: gsen-int {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio1 2 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		status = "okay";
	};

	/* OM70201WV INTN：P1.10，默认上拉输入，低电平有效 */
	battery_gauge_int: battery-gauge-int {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio1 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		status = "okay";
	};

	/* P0.3: 是否在充电的检测,外部上拉 */
	charge_det: charge-det {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio0 3 (GPIO_ACTIVE_LOW)>;
		status = "okay";
	};

	/* 把要用的 ADC 通道挂到 zephyr,user，方便 C 代码用 ADC_DT_SPEC_GET(DT_PATH(zephyr_user)) */
	zephyr,user {
		/* 通道 0：电池电压（P1.13 / AIN6）*/
		io-channels = <&adc 0>;
	};

	/* 气压计电源控制引脚：P2.09，高电平使能 */
	baro_pwr_en: baro-pwr-en {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	/* LCD 电源使能引脚：P2.00，高电平使能 */
	lcd_pwr_en: lcd-pwr-en {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 0 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	/* LCD 背光 PWM 节点：pwm21 通道0，P1.11 */
	lcd_bl_pwm: lcd-bl-pwm {
		compatible = "pwm-leds";
		lcd_bl_0: lcd_bl_0 {
			/* 背光频率1kHz，可调占空比控制亮度 */
			pwms = <&pwm21 0 PWM_HZ(1000) PWM_POLARITY_NORMAL>;
		};
	};

	/* LCD 显示屏（ST7735）MIPI-DBI 节点 */
	lcd_mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi00>;
		dc-gpios = <&gpio2 3 GPIO_ACTIVE_HIGH>;    /* P2.03 RS */
		reset-gpios = <&gpio2 4 GPIO_ACTIVE_LOW>;  /* P2.04 RESET */
		write-only;                                /* 无 MISO，禁止读操作 */
		#address-cells = <1>;
		#size-cells = <0>;

		lcd_st7735r: st7735r@0 {
			compatible = "sitronix,st7735r";
			mipi-max-frequency = <20000000>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			reg = <0>;
			width = <96>;
			height = <160>;
			x-offset = <0>;
			y-offset = <0>;
			madctl = <0x00>;
			colmod = <0x55>;
			caset = [00 00 00 5f];
			raset = [00 00 00 9f];
			vmctr1 = <0x0e>;
			pwctr1 = [a2 02 84];
			pwctr2 = [c5];
			pwctr3 = [0a 00];
			pwctr4 = [8a 2a];
			pwctr5 = [8a ee];
			frmctr1 = [01 2c 2d];
			frmctr2 = [01 2c 2d];
			frmctr3 = [01 2c 2d 01 2c 2d];
			gamctrp1 = [02 1c 07 12 37 32 29 2d 29 25 2b 39 00 01 03 10];
			gamctrn1 = [03 1d 07 06 2e 2c 29 2d 2e 2e 37 3f 00 00 02 10];
			/* rgb-is-inverted; 若实机反色再打开 */
		};
	};

};

/* 配置 NFC 使用的引脚做为IO口 */
&uicr {
	nfct-pins-as-gpios;
};

&uart20 {
	status = "disabled";
};

/* 各外设 pinctrl 引脚配置 */
&pinctrl {
	i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 3)>,
				<NRF_PSEL(TWIM_SDA, 1, 4)>;
		};
	};

	i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 3)>,
				<NRF_PSEL(TWIM_SDA, 1, 4)>;
			low-power-enable;
		};
	};

	i2c22_default: i2c22_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 8)>,
				<NRF_PSEL(TWIM_SDA, 1, 7)>;
		};
	};

	i2c22_sleep: i2c22_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 8)>,
				<NRF_PSEL(TWIM_SDA, 1, 7)>;
			low-power-enable;
		};
	};

	lte_uart30_default: lte_uart30_default {
		group1 {
			/* TX 为输出，无需偏置 */
			psels = <NRF_PSEL(UART_TX, 0, 0)>;
		};
		group2 {
			/* RX 为输入，default 状态配置上拉 */
			psels = <NRF_PSEL(UART_RX, 0, 1)>;
			bias-pull-up;
		};
	};

	lte_uart30_sleep: lte_uart30_sleep {
		group1 {
			/* sleep 状态配置低功耗模式(高阻态) */
			psels = <NRF_PSEL(UART_TX, 0, 0)>,
					<NRF_PSEL(UART_RX, 0, 1)>;
			low-power-enable;
		};
	};

	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 5)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 6)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 5)>,
				<NRF_PSEL(UART_RX, 1, 6)>;
			low-power-enable;
		};
	};

	pwm20_default: pwm20_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 12)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	pwm20_sleep: pwm20_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 12)>;
			low-power-enable;
		};
	};

	pwm21_default: pwm21_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 11)>;
		};
	};

	pwm21_sleep: pwm21_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 11)>;
			low-power-enable;
		};
	};

	spi00_default: spi00_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>;
			/* 不添加 SPIM_MISO，无 MISO 引脚 */
		};
	};

	spi00_sleep: spi00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>;
			low-power-enable;
		};
	};
};

/* 开启并配置 UART30 */
&uart30 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&lte_uart30_default>;
	pinctrl-1 = <&lte_uart30_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart20 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart20_default>;
    pinctrl-1 = <&uart20_sleep>;
    pinctrl-names = "default", "sleep";
};

/* 开启并配置 PWM 用于蜂鸣器 */
&pwm20 {
	status = "okay";
	pinctrl-0 = <&pwm20_default>;
	pinctrl-1 = <&pwm20_sleep>;
	pinctrl-names = "default", "sleep";
};

/* 开启并配置 PWM21 用于 LCD 背光 */
&pwm21 {
	status = "okay";
	pinctrl-0 = <&pwm21_default>;
	pinctrl-1 = <&pwm21_sleep>;
	pinctrl-names = "default", "sleep";
};

/* 开启并配置 I2C21 用于 G-Sensor */
&i2c21 {
	status = "okay";
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

/* 气压计 I2C 总线：P1.08(SCL), P1.07(SDA) */
&i2c22 {
	status = "okay";
	pinctrl-0 = <&i2c22_default>;
	pinctrl-1 = <&i2c22_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

/* ADC 配置：通道 0 = AIN6(P1.13) */
&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/* 通道 0：电池电压采集，AIN6 = P1.13 */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";          /* nRF54L15 推荐 1/4 增益 */
		zephyr,reference = "ADC_REF_INTERNAL"; /* 内部参考 */
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN6>;  /* AIN6 = P1.13 */
		zephyr,resolution = <14>;                  /* nRF54L15 为 14 bit */
	};
};

/* LCD 显示屏使用 SPIM00：SCK=P2.01，MOSI=P2.02，CS=P2.05（无 MISO） */
&spi00 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;  /* P2.05 CS */
};

/* Disable MX25R64 SPI NOR Flash */
&mx25r64 {
    status = "disabled";
};

/* P0.4用于唤醒 */
&gpio0 {
	// wakeup-source;
	sense-edge-mask = <(BIT(2) | BIT(3) | BIT(4))>;  /* P0.2、P0.3 和 P0.4 */
};

/* 新增：为 gpio1 启用 sense 机制，降低功耗 */
&gpio1 {
	status = "okay";
	sense-edge-mask = <(BIT(2) | BIT(9) | BIT(10) | BIT(14))>;  /* P1.2六轴INT、P1.9功能键、P1.10库仑计INT、P1.14 SOS键 */
};

&wdt31 {
	status = "okay";
};
